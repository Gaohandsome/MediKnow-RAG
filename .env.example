# =====================================================================
# MediKnow-RAG 配置示例
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密钥
# =====================================================================

# ===== 应用基础配置 =====
APP_NAME=MediKnow-RAG · 院内知识库问答
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mediknow
MYSQL_CHARSET=utf8mb4

# ===== Milvus =====
# 用 docker compose 拉起时填 http://127.0.0.1:19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION_PREFIX=kb_

# ===== 向量模型 bge-m3（稠密 + 稀疏）=====
# 权重不放仓库，下载后填本地绝对路径：
#   https://huggingface.co/BAAI/bge-m3
EMBEDDING_MODEL_PATH=/path/to/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_DIM=1024

# ===== 重排模型 bge-reranker-v2-m3 =====
#   https://huggingface.co/BAAI/bge-reranker-v2-m3
RERANK_MODEL_PATH=/path/to/models/bge-reranker-v2-m3
RERANK_ENABLED=true
RERANK_TOP_N=3

# ===== 大模型（通义千问，OpenAI 兼容接口）=====
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型 + 降级顺序：前一个 403/404 时自动换下一个，不用改代码
# qwen3 系列默认开启「深度思考」，LLM_ENABLE_THINKING=false 会显式关掉（首字延迟明显下降）
LLM_DEFAULT_MODEL=qwen3.8-max
LLM_AVAILABLE_MODELS=qwen3.8-max,qwen-max,qwen-plus,qwen3-vl-plus
LLM_ENABLE_THINKING=false
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_MAX_TOKENS=2048
LLM_HISTORY_ROUNDS=5

# 限流保护：每分钟最多发多少请求（0=不限）。
# 并发/评测打满时阿里云会返回 429 limit_requests，本地排队比整批失败划算。
LLM_MAX_RPM=60
LLM_RATE_RETRIES=5

# ===== 图片解析（多模态 OCR）=====
VISION_MODEL=qwen-vl-ocr

# ===== 图文问答（多模态生成）=====
# 带图问答必须是视觉模型；纯文本模型喂图片会失败
VISION_ENABLED=true
LLM_VL_MODEL=qwen3-vl-plus
VISION_MAX_IMAGES=3
VISION_IMAGE_MAX_SIDE=1280

# ===== 图片存储：local=后端静态目录 / qiniu=七牛云对象存储 =====
# 本地体验用 local 即可，无需任何云账号
MEDIA_STORAGE=local
MEDIA_DIR=data/media
# 留空则用 http://127.0.0.1:8001/api/v1/media
MEDIA_BASE_URL=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
MEDIA_URL_MODE=signed
MEDIA_SIGN_EXPIRE=86400
QINIU_S3_REGION=cn-south-1
QINIU_S3_HOST=

# ===== 检索参数 =====
# 子块长度：320 字 / 70 重叠，配合「按 ## 章节切父块」的解析策略
RAG_CHUNK_SIZE=320
RAG_CHUNK_OVERLAP=70
# 最终注入提示词的父块条数。50 条金标实测：金标文档 48 条排第 1、2 条排第 2，
# 第 4/5 条 72% 分数 <0.05，降到 3 条上下文省 40% 字数且指标不变。
RAG_TOP_K=3
# 精排候选广度，与 RAG_TOP_K 解耦：调小 TOP_K 不减少精排计算
RAG_CANDIDATE_K=20
RAG_SCORE_THRESHOLD=0.0
RAG_RRF_K=60

# ===== 查询理解（意图识别 / 策略选择 / 改写）=====
QUERY_REWRITE_ENABLED=true
# 少于该字数不走 LLM，直接用原问题检索（省一次调用）
QUERY_REWRITE_MIN_CHARS=12
QUERY_REWRITE_TIMEOUT=30
QUERY_REWRITE_CACHE_TTL=3600
# 单次最多展开几路 query（直接 / 简化 / 回溯 / 子问题 / HyDE）
QUERY_MAX_VARIANTS=4

# ===== 精确问答缓存（Redis + MySQL 两级）=====
QA_CACHE_ENABLED=true
# BM25 对称覆盖率阈值，达到即回放缓存答案，低于它才走 RAG
QA_CACHE_THRESHOLD=0.8
QA_CACHE_TTL=86400
QA_CACHE_MIN_ANSWER_CHARS=30
QA_CACHE_MAX_PAIRS=300
QA_HIT_FLUSH_EVERY=20

# ===== Redis（可选）=====
# 关掉或连不上会自动降级为进程内缓存；多 worker 部署建议开启
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=1.5
REDIS_URL=

# ===== 医疗安全层 =====
MEDICAL_DISCLAIMER_ENABLED=true
MEDICAL_DISCLAIMER=以上内容依据院内知识库资料整理，仅供医疗专业人员参考，不能替代执业医师的诊断与处方。
SAFETY_RED_FLAG_ENABLED=true
SAFETY_REFUSE_WHEN_NO_CONTEXT=true
# 低于该分直接拒答（bge-reranker 分数量纲，0 表示不做分数拦截）
SAFETY_MIN_SCORE=0.5

# ===== 认证 =====
# 生产环境务必改成随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE_SECONDS=180

# ===== 上传 =====
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# ===== 知识库共享 =====
# true=所有登录用户都能看到并使用全部知识库（院内资料本应全院可用），
# 但创建/改名/删除/上传/重解析仍只允许所有者操作；false=按用户隔离
KB_SHARED_READ=true
